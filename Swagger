    <script>
        function toggleSection(id) {
            const el = document.getElementById(id);
            el.style.display = (el.style.display === 'none') ? 'block' : 'none';
        }

        function toggleBody(element) {
            const body = element.nextElementSibling;
            const arrow = element.querySelector('.arrow');
            if (body.style.display === "block") {
                body.style.display = "none";
                arrow.classList.remove('rotate');
            } else {
                body.style.display = "block";
                arrow.classList.add('rotate');
            }
        }

        function toggleModel(element) {
            const content = element.nextElementSibling;
            const arrow = element.querySelector('.arrow');
            if(content.style.display === "block") {
                content.style.display = "none";
                arrow.style.transform = "rotate(0deg)";
            } else {
                content.style.display = "block";
                arrow.style.transform = "rotate(180deg)";
            }
        }

        function toggleExecute(btn) {
            const panel = btn.nextElementSibling;
            if (panel.style.display === 'block') {
                panel.style.display = 'none';
                btn.textContent = 'Testar Endpoint';
            } else {
                panel.style.display = 'block';
                btn.textContent = 'Cancelar Teste';
            }
        }

        async function executeRequest(method, path, bodyId, resId, tokenId) {
            const baseUrl = 'https://api.rvcarbon.com.br';
            const url = baseUrl + path;
            const resBox = document.getElementById(resId);
            
            resBox.style.display = 'block';
            resBox.innerHTML = '<span style="color:white">Enviando requisição...</span>';

            const headers = { 'Content-Type': 'application/json' };
            if (tokenId) {
                const tokenVal = document.getElementById(tokenId).value;
                if (tokenVal) headers['Authorization'] = 'Bearer ' + tokenVal;
            }

            const options = { method: method, headers: headers };

            if (bodyId) {
                try {
                    const rawBody = document.getElementById(bodyId).value;
                    JSON.parse(rawBody); 
                    options.body = rawBody;
                } catch (e) {
                    resBox.innerHTML = '<span style="color:#f93e3e">Erro: JSON Inválido.</span>';
                    return;
                }
            }

            try {
                const response = await fetch(url, options);
                
                // Tratamento especial para REDIRECT (302) e HTML Responses
                const statusColor = (response.status >= 200 && response.status < 300) || response.status === 302 ? '#49cc90' : '#f93e3e';
                
                // Tratamento especial para Download de XLS
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.includes("spreadsheetml")) {
                    resBox.innerHTML = `<span class="response-status" style="color:${statusColor}">Status: ${response.status} OK</span>` + 
                                       '<br>📥 <strong>Arquivo Excel recebido!</strong> (Download iniciado pelo navegador...)';
                    // Lógica para forçar o download no navegador
                    const blob = await response.blob();
                    const downloadUrl = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = downloadUrl;
                    a.download = "relatorio-arva.xlsx";
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    return;
                }

                let responseData;
                if (contentType && contentType.indexOf("application/json") !== -1) {
                    responseData = await response.json();
                    responseData = JSON.stringify(responseData, null, 2);
                } else {
                    responseData = await response.text();
                     // Se for HTML (página de sucesso), mostra um aviso amigável
                     if (responseData.includes("<!DOCTYPE html>")) {
                        responseData = "(HTML Page Content - Redirecionamento realizado com sucesso)";
                    }
                }
                
                // Se houve redirecionamento (response.redirected é true)
                let statusText = response.statusText;
                if (response.redirected) {
                    statusText += " (Redirecionado)";
                }

                resBox.innerHTML = `<span class="response-status" style="color:${statusColor}">Status: ${response.status} ${statusText}</span>` + responseData;
            } catch (error) {
                resBox.innerHTML = '<span class="response-status" style="color:#f93e3e">Erro de Conexão (CORS ou Offline)</span>';
                console.error(error);
            }
        }

        function generatePDF() {
            const element = document.getElementById('printable-area');
            const opt = {
                margin: [0.5, 0.5, 0.5, 0.5],
                filename: 'RvCarbon_Complete_Docs.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true },
                jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
            };
            const bodies = document.querySelectorAll('.op-block-body');
            const models = document.querySelectorAll('.model-content');
            bodies.forEach(b => b.style.display = 'block');
            models.forEach(m => m.style.display = 'block');
            html2pdf().set(opt).from(element).save().then(() => {
                bodies.forEach(b => b.style.display = 'none');
                models.forEach(m => m.style.display = 'none');
            });
        }
    </script>
